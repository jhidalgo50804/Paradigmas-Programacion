@model LoginViewModel
@{
    Layout = null;
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="container py-5">
    <div class="row g-4">
        <div class="col-md-5">
            <div class="cc-left h-100">
                <h2>☕ CoffeConnect</h2>
                <h3 class="mt-5 fw-bold">Conecta con caficultores, comparte experiencias</h3>
                <img src="~/img/finca.jpg" class="img-fluid mt-4" />
            </div>
        </div>
        <div class="col-md-7">
            <div class="cc-card">
                <h1 class="fw-bold" style="color:var(--green-dark)">Bienvenido de vuelta</h1>
                <form asp-action="Login" method="post" class="mt-4">
                    <label>Email</label>
                    <input asp-for="Email" class="cc-input" placeholder="tuemail@ejemplo.com" />
                    <label class="mt-3">Contraseña</label>
                    <input asp-for="Password" type="password" class="cc-input" placeholder="••••••••" />
                    <div class="mt-3"><input asp-for="RememberMe" /> Recordarme</div>
                    <button class="cc-btn mt-4">Iniciar sesión</button>
                    <div class="text-center mt-4">
                        ¿No tienes cuenta?<br />
                        <a asp-action="Register" style="color:var(--green-btn)">Crea una aquí</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>