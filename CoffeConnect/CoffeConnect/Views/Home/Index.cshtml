@model List<Publicacion>
@{
    Layout = "_Layout";
}
<div class="d-flex gap-4 mt-3 align-items-start">
    @* IZQUIERDA *@
    @await Html.PartialAsync("_SidebarUsuario")

    @* CENTRO *@
    <div class="flex-grow-1">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0">Comunidad</h3>
            <button class="btn text-white px-4" style="background:#3A8A4E; border-radius:10px;" data-bs-toggle="modal" data-bs-target="#crearModal">
                + Crear
            </button>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="card rounded-4 p-5 text-center border-0 shadow-sm">
                <h5>🌱 Aún no hay publicaciones</h5>
                <p class="text-muted">Sé el primero en compartir algo con la comunidad.</p>
                <button class="btn text-white mx-auto" style="background:#3A8A4E;" data-bs-toggle="modal" data-bs-target="#crearModal">Crear primera publicación</button>
            </div>
        }
        else
        {
            @foreach (var pub in Model)
            {
                <div class="card mb-3 rounded-4 shadow-sm border-0">
                    <div class="card-body">
                        <small class="text-muted">@(pub.User?.NombreCompleto ?? "Usuario") • @pub.FechaCreacion.ToString("dd MMM")</small>
                        <span class="badge bg-light text-dark border ms-2">@pub.Tema</span>
                        <h5 class="mt-2 fw-bold">@pub.Titulo</h5>
                        <p>@pub.Descripcion</p>
                        @if (!string.IsNullOrEmpty(pub.ImagenUrl))
                        {
                            <img src="@pub.ImagenUrl" class="img-fluid rounded-3 mb-3" style="max-height:300px; width:100%; object-fit:cover;" />
                        }
                        <div class="d-flex gap-2">
                            <form asp-action="Like" method="post">
                                <input type="hidden" name="id" value="@pub.Id" />
                                <button class="btn btn-outline-danger btn-sm"><i class="bi bi-heart-fill"></i> @(pub.Likes?.Count ?? 0)</button>
                            </form>
                            <span class="btn btn-light btn-sm"><i class="bi bi-chat"></i> @(pub.Comentarios?.Count ?? 0)</span>
                        </div>
                        <hr />
                        @if (pub.Comentarios != null)
                        {
                            @foreach (var c in pub.Comentarios)
                            {
                                <p class="mb-1"><b>@(c.User?.NombreCompleto ?? "Usuario"):</b> @c.Texto</p>
                            }
                        }
                        <form asp-action="Comentar" method="post" class="d-flex gap-2 mt-2">
                            <input type="hidden" name="publicacionId" value="@pub.Id" />
                            <input name="texto" class="form-control form-control-sm" placeholder="Escribe un comentario..." required />
                            <button class="btn btn-sm text-white" style="background:#3A8A4E;">Enviar</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>

    @* DERECHA - Nuevo sidebar *@
    @await Html.PartialAsync("_SidebarQuizaConozcas")
</div>

<!-- MODAL -->

<div class="modal fade" id="crearModal" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" asp-controller="Comunidad" asp-action="Crear" enctype="multipart/form-data" method="post">
            <div class="modal-header"><h5>Crear publicación</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input name="Titulo" class="form-control mb-2" placeholder="Título" required />
                <select name="Tema" class="form-control mb-2"><option>General</option><option>Plagas</option><option>Cosecha</option><option>Mercado</option><option>Técnicas</option></select>
                <textarea name="Descripcion" class="form-control mb-2" placeholder="Descripción" required></textarea>
                <input type="file" name="Imagen" class="form-control" accept="image/*" />
            </div>
            <div class="modal-footer"><button type="submit" class="btn w-100 text-white" style="background:#3A8A4E;">Publicar</button></div>
        </form>
    </div>
</div>